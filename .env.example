# ─────────────────────────────────────────────
# Mediko Chat API — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Which proxy hops to trust for the client IP (rate limits key on it).
# Default "loopback" = nginx on the same host talking to 127.0.0.1.
# Under docker compose the proxy reaches the container from the bridge
# gateway, so use: TRUST_PROXY=loopback,172.16.0.0/12
# Also accepts a hop count (1), true/false, or a comma list of IPs/CIDRs.
TRUST_PROXY=loopback

# Google Gemini (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-pro    # higher quality, paid
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7
GEMINI_THINKING_BUDGET=0

# Rate limiting / spam — keep RPM/RPD below your Gemini free-tier quota.
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=200
SESSION_BURST_MAX=6
SESSION_BURST_WINDOW=15
SESSION_DAILY_MAX=60

# AI replies (Gemini) — on only when exactly "true". When off, every widget
# message goes to the human team (live agent chat).
AI_ENABLED=false

# MySQL
# Host: 127.0.0.1 when the API runs on the host; "db" inside docker compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mediko
DB_PASSWORD=change_me
DB_NAME=mediko_chat

# Shopify (Phase 2)
SHOPIFY_STORE_DOMAIN=store.mediko.ph
SHOPIFY_STOREFRONT_TOKEN=         # Public Storefront API token (products/content)
# Order tracking — only set true if SHOPIFY_ADMIN_TOKEN has the read_orders scope.
SHOPIFY_ORDERS_ENABLED=false
SHOPIFY_ADMIN_TOKEN=              # Admin API token with read_orders (for order lookups)

# Security
# Lock to your Shopify store origin in production
WIDGET_ALLOWED_ORIGIN=https://store.mediko.ph
# Use * for local dev only:
# WIDGET_ALLOWED_ORIGIN=*

# Browser origins allowed to call this API (comma list). Falls back to WIDGET_ALLOWED_ORIGIN.
ALLOWED_ORIGINS=https://store.mediko.ph,https://mediko-gateway.quailshack.com
# Shared with the gateway: signs/verifies agent JWTs, chat links and chat events (32+ chars)
CHAT_AGENT_SECRET=
GATEWAY_URL=https://mediko-gateway.quailshack.com
GATEWAY_ORIGIN=https://mediko-gateway.quailshack.com
CHAT_CUSTOMER_URL=https://store.mediko.ph/pages/test-page

META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ─────────────────────────────────────────────
# Mediko Chat API — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano
# OPENAI_MODEL=gpt-4o           # higher quality, paid
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# AI kill-switch — set to "false" to stop calling OpenAI (saves tokens).
# When off, customers see AI_DISABLED_MESSAGE and can click "Talk to agent".
AI_ENABLED=true
AI_DISABLED_MESSAGE=Pasensya na po, ang aming AI assistant ay pansamantalang hindi available. Paki-click po ang 'Talk to agent' button para makausap ang aming team.

# Supabase (use service role key — server-side only)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Shopify (Phase 2)
SHOPIFY_STORE_DOMAIN=store.mediko.ph
SHOPIFY_STOREFRONT_TOKEN=         # Public Storefront API token
SHOPIFY_ADMIN_TOKEN=              # Private Admin API token (for order lookups)

# Security
# Lock to your Shopify store origin in production
WIDGET_ALLOWED_ORIGIN=https://store.mediko.ph
# Use * for local dev only:
# WIDGET_ALLOWED_ORIGIN=*

ADMIN_SECRET=

META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
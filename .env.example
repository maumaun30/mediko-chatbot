# ─────────────────────────────────────────────
# Mediko Chat API — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Google Gemini (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-pro    # higher quality, paid
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7
GEMINI_THINKING_BUDGET=0

# Rate limiting / spam — keep RPM/RPD below your Gemini free-tier quota.
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=200
SESSION_BURST_MAX=6
SESSION_BURST_WINDOW=15
SESSION_DAILY_MAX=60

# AI kill-switch — set to "false" to stop calling OpenAI (saves tokens).
# When off, customers see AI_DISABLED_MESSAGE and can click "Talk to agent".
AI_ENABLED=true
AI_DISABLED_MESSAGE=Pasensya na po, ang aming AI assistant ay pansamantalang hindi available. Paki-click po ang 'Talk to agent' button para makausap ang aming team.

# MySQL
# Host: 127.0.0.1 when the API runs on the host; "db" inside docker compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mediko
DB_PASSWORD=change_me
DB_NAME=mediko_chat

# Shopify (Phase 2)
SHOPIFY_STORE_DOMAIN=store.mediko.ph
SHOPIFY_STOREFRONT_TOKEN=         # Public Storefront API token (products/content)
# Order tracking — only set true if SHOPIFY_ADMIN_TOKEN has the read_orders scope.
SHOPIFY_ORDERS_ENABLED=false
SHOPIFY_ADMIN_TOKEN=              # Admin API token with read_orders (for order lookups)

# Security
# Lock to your Shopify store origin in production
WIDGET_ALLOWED_ORIGIN=https://store.mediko.ph
# Use * for local dev only:
# WIDGET_ALLOWED_ORIGIN=*

ADMIN_SECRET=

META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=